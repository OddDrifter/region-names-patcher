<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Serialization" Version="1.37.1" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.Newtonsoft" Version="1.37.1" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.SourceGenerator" Version="1.37.1" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.51.5" />
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.35.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="InternalData\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
